{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build and Run C (gcc)",
            "command": "C:/mingw64/bin/gcc.exe -g '${file}' -o '${fileBasenameNoExtension}.exe'; if ($?) { ./'${fileBasenameNoExtension}.exe' }",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Build and Run C++ SFML (g++)",
            "command": "C:/mingw64/bin/g++.exe -g -IC:/SFML-3.1.0/include '${file}' -LC:/SFML-3.1.0/lib -lsfml-graphics -lsfml-window -lsfml-system -lsfml-audio -lsfml-network -o '${fileBasenameNoExtension}.exe'; if ($?) { ./'${fileBasenameNoExtension}.exe' }",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
